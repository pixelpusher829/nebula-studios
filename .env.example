# Public URL of the deployed site (used for canonical URLs, sitemap and social cards)
VITE_SITE_URL=https://nebulastudios.com

# Where contact / newsletter / job-application forms are POSTed (e.g. a Formspree endpoint).
# Leave empty in development to log submissions to the console instead.
VITE_FORMS_ENDPOINT=

# Show the AI assistant widget ("true" / "false"). Requires GEMINI_API_KEY on the server.
VITE_CHAT_ENABLED=false

# Server-side only, read by api/chat.ts. Never prefix with VITE_.
GEMINI_API_KEY=
